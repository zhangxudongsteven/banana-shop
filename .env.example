# Tale Authentication Configuration (@turinhub/tale-js-sdk v2.3.0)
# Get your credentials from your Tale admin panel
TALE_BASE_URL=https://your-tale-api-url.com
TALE_APP_KEY=your_app_key_here
TALE_APP_SECRET=your_app_secret_here

# ========== Volcengine Ark Provider Configuration ==========
# Required when using the default image edit, vision analysis, or video generation profiles.
# Get your API key at https://console.volcengine.com/iam/aksk/
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# Optional. Defaults to the Beijing Ark OpenAI-compatible endpoint.
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ----- Image Models -----
# Vision analysis profile for image understanding workflows.
VOLCENGINE_VISION_MODEL=doubao-seed-2-0-lite-260215
# Text-to-image fallback profile.
VOLCENGINE_IMAGE_MODEL=doubao-seed-2-0-lite-260215
# Image editing profile. Seedream uses reference_images for image-to-image generation.
VOLCENGINE_EDIT_MODEL=doubao-seedream-5-0-260128

# ----- Video Models -----
# Video generation profile.
VOLCENGINE_VIDEO_MODEL=doubao-video-1

# ========== DeepSeek Official Chat Provider Configuration ==========
# Required for chat completions. Uses the official DeepSeek API directly.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ----- Chat Models -----
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# ========== GLM / Z.ai Image Provider Configuration ==========
# Used by the glmImage text-to-image profile
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_IMAGE_MODEL=glm-image

# ========== Aliyun DashScope / Model Studio Provider Configuration ==========
# ALIYUN_DASHSCOPE_API_KEY is preferred; DASHSCOPE_API_KEY is also supported for compatibility
ALIYUN_DASHSCOPE_API_KEY=your_aliyun_dashscope_api_key_here
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_IMAGE_MODEL=qwen-image-2.0-pro
ALIYUN_EDIT_MODEL=qwen-image-2.0-pro
